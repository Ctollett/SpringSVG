{
  "name": "getruun",
  "version": "0.1.0",
  "description": "Spring-powered SVG path morphing — animate between any two SVG shapes with real spring physics, no keyframes required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "svg",
    "animation",
    "spring",
    "physics",
    "morph",
    "svg-morphing",
    "path-animation",
    "path-morphing",
    "motion",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://getruun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ctollett/ruun-svg.git",
    "directory": "packages/ruune"
  },
  "bugs": {
    "url": "https://github.com/Ctollett/ruun-svg/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
