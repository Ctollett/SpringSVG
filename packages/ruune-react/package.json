{
  "name": "getruun-react",
  "version": "0.1.0",
  "description": "React wrapper for the Ruune SVG morphing library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "getruun": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "react": "^19.2.4"
  },
  "license": "MIT",
  "homepage": "https://getruun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ctollett/ruun-svg.git",
    "directory": "packages/ruune-react"
  },
  "bugs": {
    "url": "https://github.com/Ctollett/ruun-svg/issues"
  },
  "keywords": [
    "svg",
    "animation",
    "spring",
    "physics",
    "morph",
    "react"
  ]
}
